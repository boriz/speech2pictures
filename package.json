{
  "name": "speech2pictures-lint",
  "private": true,
  "version": "1.0.0",
  "description": "Local lint tooling for Speech2Pictures templates",
  "scripts": {
    "lint": "npm run lint:js",
    "lint:js": "node tools/lint_js_templates.mjs",
    "lint:js:fix": "node tools/lint_js_templates.mjs --fix",
    "format:js:check": "prettier --check \"templates/**/*.html\" \"*.json\"",
    "format:js": "prettier --write \"templates/**/*.html\" \"*.json\""
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "prettier": "^3.5.3"
  }
}
